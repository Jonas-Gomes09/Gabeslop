<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carrinho</title>

    <link rel="stylesheet" href="/css/carrinho.css">
</head>

<header class="navbar" id="nav">
    <a href="/" class="nav-logo" aria-label="Página Inicial GabeSlop">
      <img src="img/logoGabeSlop.png" alt="GabeSlop Logo">
    </a>
    
    <nav>
      <ul class="nav-links">
        <li><a href="/">Início</a></li>
        <li><a href="/promocoes">Promoções</a></li>
        <li><a href="/lancamentos">Lançamentos</a></li>
  
        <% if (typeof nome !== 'undefined' && nome) { %>
          <li class="user-info">
            <span class="user">👤 <%= nome %></span>
            <a href="/logout" style="color: #E74C3C;">Sair</a>
          </li>
        <% } %>
      </ul>
    </nav>
  </header>

<div class="carrinho">

<h1>🛒 Carrinho de Compras</h1>

<% if(itens.length === 0){ %>

    <div class="vazio">
        Seu carrinho está vazio.
    </div>

<% } else { %>

<table>

<thead>

<tr>
    <th>Imagem</th>
    <th>Produto</th>
    <th>Preço</th>
    <th>Quantidade</th>
    <th>Subtotal</th>
    <th>Remover</th>
</tr>

</thead>

<tbody>

<% itens.forEach(item => { %>

<tr>

<td>

<% if(item.imagem){ %>

<img src="<%= item.imagem %>" alt="<%= item.nome %>">

<% } %>

</td>

<td>

<%= item.nome %>

</td>

<td>

R$ <%= item.preco.toFixed(2) %>

</td>

<td>

<form action="/carrinho/atualizar/<%= item.produtoId %>" method="POST">

<input
type="number"
name="quantidade"
value="<%= item.quantidade %>"
min="1"
>

<button type="submit">
Atualizar
</button>

</form>

</td>

<td>

R$ <%= (item.preco * item.quantidade).toFixed(2) %>

</td>

<td>

<form action="/carrinho/remover/<%= item.produtoId %>" method="POST">

<button type="submit">
🗑️
</button>

</form>

</td>

</tr>

<% }) %>

</tbody>

</table>

<div class="total">

<strong>

Total:

R$ <%= total.toFixed(2) %>

</strong>

</div>

<div class="acoes">

<a href="/" class="btn voltar">

Continuar Comprando

</a>

<form action="/carrinho/limpar" method="POST">

<button class="btn limpar">

Limpar Carrinho

</button>

</form>

<button class="btn finalizar">

Finalizar Compra

</button>

</div>

<% } %>

</div>

<script src="/js/cart.js"></script>

</body>
</html>