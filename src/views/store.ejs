<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carrinho</title>

    <link rel="stylesheet" href="/css/store.css">
</head>
<body>

<header class="navbar" id="nav">
  <a href="/" class="nav-logo" aria-label="Página Inicial GabeSlop">
    <img src="img/logoGabeSlop.png" alt="GabeSlop Logo">
  </a>
  
  <nav>
    <ul class="nav-links">
      <li><a href="/">Início</a></li>
      <li><a href="/naoexiste">Promoções</a></li>
      <li><a href="/naoexiste">Lançamentos</a></li>

      <% if (typeof nome !== 'undefined' && nome) { %>
        <div class="user-info">

          <a href="/logoff" style="color: #E74C3C; margin-left: .5rem;">Sair</a>
          <span class="user" style="margin-left: 1rem; font-weight: 700;"><%= nome %></span>
          <img 
            id="avatar-header" 
            alt="Foto de perfil de: <%= nome %>" 
            class="user-avatar"
            src="<%= foto %>"
          >
        </li>
      <% } %>
    </ul>
  </nav>
</header>

<div class="carrinho">
    <h1>Seu carrinho</h1>

    <div id="loading-cart" style="display: none;">Carregando...</div>
    <div id="carrinho-vazio" class="vazio" style="display: none;">
        Seu carrinho está vazio.
    </div>

    <p id="loadingcart" style="display: none;">loading...</p>
    <div class="clist" id="clist"></div>
    <p style="color: black;" id="totalItensCarrinho">Total de itens: 0</p>
    <div class="total"><strong id="cart-total" style="color: black;">Valor total: R$ 0.00</strong></div>

    <div class="acoes">
        <button id="esvaziar" class="btn limpar">Esvaziar Carrinho</button>
        <button id="finalizar" class="btn finalizar">Finalizar Compra</button>
    </div>
</div>

<!-- LOJA EM SÍ -->

<div class="store">


<h1 style="font-size: 6rem; font-weight: 800; margin-top: 3rem; margin-bottom: 2rem;">LOJA</h1>
<p id="loading" style="display: none;">Loading...</p>
<p id="producttotal">0</p>
<input type="text" class="searchbar" placeholder="Pesquise por nosso catálogo de jogos">
<div class="plist" id="plist"></div>

</div>

<script src="/js/store.js"></script>
</body>
</html>