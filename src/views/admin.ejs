<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Painel do Administrador</title>
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>

    <div class="sidebar">
        <div class="logodiv">
        <img class="logo" src="img/logoGabeSlop.png" alt="GabeSlop Logo">
        <h1 class="title">PAINEL DO ADMINISTRADOR</h1>
        </div>

        <div class="buttons">
            <button class="sideBarButton" onclick="window.location.href='/admin/users'">USUÁRIOS</button>
            <button class="sideBarButton" onclick="window.location.href='/admin/products'">PRODUTOS</button>
        </div>
    </div>
    <div class="console">
        <h1 class="consoleTitle">Console</h1>
        <% if (console.length == 0) { %>
            <h3 class="consoleEmpty">Não há nada por aqui.</h3>
        <% } else { %>
            <% for(i = 0; i < console.length; i++) {%>
                <p class="consoleItem"><%= console[i] %></p>
            <% } %>
        <% } %>
    </div>

</body>
</html>