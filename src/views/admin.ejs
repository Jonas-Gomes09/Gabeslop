<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Painel do Administrador</title>
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>

    <div class="sidebar">
        <div class="logodiv">
        <img class="logo" src="img/logoGabeSlop.png" alt="GabeSlop Logo">
        <h1 class="title">PAINEL DO ADMINISTRADOR</h1>
        </div>

        <div class="buttons">
            <button class="sideBarButton" id="toggleConsole">CONSOLE</button>
            <button class="sideBarButton" id="toggleUsers">USUÁRIOS</button>
            <button class="sideBarButton" id="toggleProducts">PRODUTOS</button>
            <button class="sideBarButton" id="logoff">SAIR</button>
        </div>
    </div>
    <div class="main">

        <div class="nothinghere" id="nothinghere">
            <h1 style="font-size: 5rem; color: rgba(255,255,255,.5);">Bem-vindo ao Painel de Administrador!</h1>
            <p>Utilize os botões da barra lateral para navegar.</p>
        </div>

        <div class="console" id="console">     
            <div class="main-header">
                <h1 class="consoleTitle">Console</h1>
            </div>   
            <% if (console.length == 0) { %>
                <h3 class="consoleEmpty">Ocorreu um erro ao carregar o console.</h3>
            <% } else { %>
                <% for(i = 0; i < console.length; i++) {%>
                    <p class="consoleItem"><%= console[i] %></p>
                <% } %>
            <% } %>
        </div>

        <div class="listdiv" id="users">
            <div class="main-header">
                <h1 class="consoleTitle">Usuários</h1>
                <p id="usertotal" class="total">Total: 0</p>
            </div>
            <div class="listarea" id="userlist">
                <h3 style="color: rgba(255,255,255,.5); align-self: center;" id="loading">Carregando usuários...</h3>
                <div class="ulist" id="ulist"></div>
            </div>
            
        </div>

        <div class="listdiv" id="products">
            <div class="main-header">
                <h1 class="consoleTitle">Produtos</h1>
                <button class="add-product-activator" id="addProductPage">ADICIONAR PRODUTO</button>
                <p id="producttotal" class="total">Total: 0</p>
            </div>
            <div class="listarea" id="productlist">
                <h3 style="color: rgba(255,255,255,.5); align-self: center;" id="loadingprod">Carregando produtos...</h3>
                
                <div class="plist" id="plist"></div>
            </div>
            
        </div>

        <div class="addpdiv" id="addProduct">
            <h1 style="font-size: 6rem">Adicionar produto</h1>
            <form class="addProduct" method="POST" action="/admin/store" enctype="multipart/form-data">
                <label>Nome do produto</label><input class="searchbar" type="text" name="titulo" placeholder="Digite um nome para o produto" required>
                <label>Preço em R$</label><input class="searchbar" type="number" onblur="formatarMoeda(this)" step="0.01" name="preco" placeholder="Digite um valor maior que 0" required> 
                <label>Estoque</label><input class="searchbar" type="number" name="estoque" placeholder="Digite um valor" required> 
                <label>Categoria</label>
                <select name="categoria" class="categoria" style="margin-bottom: 1rem;" required>
                    <optgroup label ="Hardware">
                        <option value="Console">Console</option>
                        <option value="Acessório">Acessório</option>
                        <option value="Periférico">Periférico</option>
                        <option value="Colecionável">Colecionável</option>
                    </optgroup>
                    <optgroup label="Ação e Tiro">
                        <option value="Jogo FPS">Jogo FPS (Tiro em Primeira Pessoa)</option>
                        <option value="Jogo TPS">Jogo TPS (Tiro em Terceira Pessoa)</option>
                        <option value="Jogo de ação">Jogo de Ação</option>
                        <option value="Hack and Slash">Hack and Slash</option>
                        <option value="Battle Royale">Battle Royale</option>
                    </optgroup>

                    <optgroup label="Aventura e RPG">
                        <option value="Jogo de aventura">Jogo de Aventura</option>
                        <option value="Action RPG">Action RPG</option>
                        <option value="RPG de Turno">RPG de Turno</option>
                        <option value="MMORPG">MMORPG</option>
                        <option value="JRPG">JRPG</option>
                    </optgroup>

                    <optgroup label="Estratégia e Arena">
                        <option value="MOBA">MOBA</option>
                        <option value="Estratégia em Tempo Real (RTS)">Estratégia em Tempo Real (RTS)</option>
                        <option value="Estratégia por Turnos (TBS)">Estratégia por Turnos (TBS)</option>
                        <option value="Tower Defense">Tower Defense</option>
                        <option value="Card Game / Construção de Deck">Card Game / Construção de Deck</option>
                    </optgroup>

                    <optgroup label="Simulação e Esportes">
                        <option value="Simulador">Simulador (Vida, Veículos, Voo)</option>
                        <option value="Jogo de esporte">Jogo de Esporte</option>
                        <option value="Jogo de corrida">Jogo de Corrida</option>
                        <option value="Gerenciamento / Tycoon">Gerenciamento / Tycoon</option>
                    </optgroup>

                    <optgroup label="Casual e Outros">
                        <option value="Plataforma">Plataforma (2D / 3D)</option>
                        <option value="Puzzle / Enigma">Puzzle / Enigma</option>
                        <option value="Luta">Jogo de Luta</option>
                        <option value="Terror / Survival Horror">Terror / Survival Horror</option>
                        <option value="Metroidvania">Metroidvania</option>
                        <option value="Roguelike / Roguelite">Roguelike / Roguelite</option>
                        <option value="Visual Novel / Sandbox">Visual Novel / Sandbox</option>
                    </optgroup>
                </select>
                <label>Foto do produto</label><input class="addFile" style="margin-bottom: 1rem;" type="file" name="foto" accept="image/*" required>
                <button type="submit" class="sideBarButton" id="submitProduct">Enviar</button>
            </form>
        </div>

    </div>
<script src="/js/admin.js"></script>
</body>
</html>