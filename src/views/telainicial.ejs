<div class="carousel">
    <h2>CONSOLES</h2>
  <div class="carousel-track">
    <div class="carousel-item"><img src="img/Ccdi2.png" alt="Pôster 1" class="anuncio"></div>
    <div class="carousel-item"><img src="img/Cgbt.png" alt="Pôster 2" class="anuncio"></div>
    <div class="carousel-item"><img src="img/Cgs.png" alt="Pôster 3" class="anuncio"></div>
  </div>
  <button id="prev" class="btn">Anterior</button>
  <button id="next" class="btn">Próximo</button>
</div>

  <script>
    const track = document.querySelector('.carousel-track');
    const items = Array.from(track.children);
    const nextButton = document.querySelector('#next');
    const prevButton = document.querySelector('#prev');

    let currentIndex = 0;

    function updateCarousel() {
      const amountToMove = -currentIndex * 100;
      track.style.transform = `translateX(${amountToMove}%)`;
    }

    nextButton.addEventListener('click', () => {
      currentIndex = (currentIndex + 1) % items.length;
      updateCarousel();
    });

    prevButton.addEventListener('click', () => {
      currentIndex = (currentIndex - 1 + items.length) % items.length;
      updateCarousel();
    });
  </script>

